{
	"manifest_version": 3,
	"name": "LinearnTrack",
	"version": "1.0",
	"description": "AI-powered KENO & Dice analytics for Stake.com",
	"permissions": ["storage", "activeTab", "scripting", "userScripts", "sidePanel"],
	"host_permissions": ["<all_urls>"],
	"action": {
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"side_panel": {
		"default_path": "popup/popup.html"
	},
	"background": {
		"service_worker": "background-scripts/background.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content-script.js"]
		}
	],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
